{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "headers": [
    { "source": "/downloads/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}] },
    { "source": "/(.*)", "headers": [{"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}] }
  ]
}
